# Jobinno environment.
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and
# must stay that way. Nothing in this file should ever carry a live secret.
#
# Two groups below. "IN USE" vars are read by code that exists today (grep
# `process.env` across `lib/` and `inngest/` and you will find every one of
# them). "NOT YET WIRED" vars are provisioned ahead of the tickets that will
# need them; nothing reads them yet, and an empty value breaks nothing today.


# ══════════════════════════════════════════════════════════════════════════════
# IN USE: read by the modules ported from actinno
# ══════════════════════════════════════════════════════════════════════════════

# == Job discovery =============================================================
# Apify token. Read by lib/search-job-listings.ts.
# apify.com/settings/integrations
APIFY_API_TOKEN=

# == Browser automation and the LLMs that drive it =============================
# The key that pays for every page Stagehand reads on a real employer's job
# board. Read by lib/stagehand-session.ts and the modules that open sessions
# through it. Deliberately its own key rather than a shared one: it should be
# independently rotatable and independently billable.
STAGEHAND_LLM_API_KEY=

# JOB-175. Set to exactly "fireworks" to drive Stagehand with Fireworks
# hosted DeepSeek V4 Flash through lib/fireworks-client-llm.ts instead of the
# default openai/gpt-5.6-luna path. Any other value, including unset, keeps
# the default. Read by lib/stagehand-session.ts.
STAGEHAND_LLM_PROVIDER=

# Pays for calls Stagehand makes when STAGEHAND_LLM_PROVIDER=fireworks.
# Falls back to STAGEHAND_LLM_API_KEY if unset. Read by
# lib/stagehand-session.ts and lib/fireworks-client-llm.ts.
# fireworks.ai/account/api-keys
FIREWORKS_API_KEY=

# Resume parsing and free text answer generation. Read by lib/resume-parser.ts.
# Optional. Falls back to STAGEHAND_LLM_API_KEY.
#
# It has a separate name because the two LLM surfaces are different trust
# domains. STAGEHAND_LLM_API_KEY pays for calls that drive a browser; this one
# pays for calls that are text in, text out, with no tools attached and no
# ability to act. That is the only reason it is safe to hand a candidate's
# resume to it.
RESUME_LLM_API_KEY=

# == Remote browsers ===========================================================
# Browserbase runs the Stagehand sessions. Read by lib/stagehand-session.ts.
#
# Set both and every session is a remote Browserbase one. Leave both unset and
# it opens a local Chromium exactly as it did before JOB-005, which is what
# keeps `npm run fill-form` working on a machine with no Browserbase account.
# Setting one without the other is refused at launch rather than quietly
# treated as local, because that combination is a typo every time.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional, off unless set to exactly 1. Attaches a persistent Browserbase
# Context to every session, so one fingerprint and one cookie jar are reused
# across runs for the same person and a board sees a returning device rather
# than a new machine each time. The context id is minted on first use and kept
# in profiles.browserbase_context_id.
#
# Available on the Developer plan, verified against the live contexts API. The
# stealth features that are NOT available there, advancedStealth and Verified
# Agents, are Scale tier and tracked separately in issue #89.
#
# Safe to leave unset: every failure path falls back to an ordinary ephemeral
# session rather than failing the run.
BROWSERBASE_CONTEXTS_ENABLED=

# Optional. How many sessions this project may run at once, which is also the
# width `applyToJob` fans out to in inngest/job-application-pipeline.ts.
# Defaults to 3, the cap `GET /v1/projects/{id}` reports for the plan this
# project is on. Raise it here when the plan changes, not in code. Ignored
# entirely on the local path, which has its own lower limit for its own reasons.
BROWSERBASE_CONCURRENCY=

# == Antibot vendors (JOB-187) ==================================================
# The self hosted recaptcha-harvester that mints Ashby's reCAPTCHA v3 tokens
# from an environment that scores well on Ashby's site key, instead of letting
# Ashby's own client script mint one inside a Browserbase session (which
# routinely fails as RECAPTCHA_SCORE_BELOW_THRESHOLD). Read by
# lib/ashby-recaptcha.ts, called from the Ashby branch of
# lib/submit-application.ts.
#
# Defaults to http://127.0.0.1:3131 when unset, which is the harvester running
# locally. Point this at the deployed harvester once JOB-187's Fly.io ticket
# lands; until then local dev is the only place this integration can run.
HARVESTER_URL=

# Optional. Required when HARVESTER_URL points at a public harvester deployment.
HARVESTER_API_KEY=

# == Supabase ==================================================================
# Read by lib/candidate-intake.ts, lib/resume-parser.ts,
# lib/fill-application-form.ts and lib/submit-application.ts.
#
# Note: the ported modules read SUPABASE_URL, while the Next.js app side reads
# NEXT_PUBLIC_SUPABASE_URL (below). They are the same project, spelled twice,
# until the ticket that unifies them lands. Set both to the same value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The one hosted Supabase project this checkout is allowed to read or write.
# Read by lib/supabase-project-guard.ts, which every module above calls before
# it creates a client.
#
# The value is the project ref, which is the first label of the SUPABASE_URL
# hostname: for https://efyubrtiptcsrhfakbwc.supabase.co the ref is
# efyubrtiptcsrhfakbwc, and that is Jobinno's own project. When SUPABASE_URL
# names anything else the guard refuses to run, so that a stale shell, a copied
# .env.local or a misaimed deploy cannot file a real candidate's rows in
# somebody else's database. The service role key bypasses row level security,
# so nothing further downstream would object.
#
# localhost and 127.0.0.1 are always allowed and never compared, because a
# local or self hosted Supabase has no project ref. CI relies on that.
#
# Unset is an error rather than a free pass: "nothing configured" and "any
# project is fine" are different statements and only one of them is safe.
EXPECTED_SUPABASE_PROJECT_REF=

# == Supabase, app side ========================================================
# Auth and the browser client. Read by lib/supabase/client.ts,
# lib/supabase/server.ts and middleware.ts, so they are required for the app to
# start, not just for the pipeline.
#
# NEXT_PUBLIC_ vars are compiled into the client bundle and are public by
# definition. Never put a service role key in one. What keeps the anon key safe
# to ship is row level security, not the key.
#
# Set NEXT_PUBLIC_SUPABASE_URL to the same value as SUPABASE_URL above. They
# name the same project twice until the ticket that unifies them lands.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# The server side key that bypasses row level security is SUPABASE_SERVICE_ROLE_KEY,
# declared once above. It is not repeated here: a .env file with the same key
# twice silently keeps whichever line loads last, and this one is the key you
# least want a stale duplicate of.

# == Database ==================================================================
# Postgres connection string for Drizzle. In production this is the Supabase
# project's pooled connection string. Read by lib/db/client.ts, which is how
# JOB-003's board sync writes `boards` and `jobs`.
#
# Anything destructive that runs against this (a truncating test, a migration
# script) must be gated behind its own explicit opt in env var. See HARD STOP 5
# in CLAUDE.md.
DATABASE_URL=

# == Billing (JOB-010) =========================================================
# Stripe. Read by lib/billing/stripe.ts, app/api/billing/checkout/route.ts and
# app/api/webhooks/stripe/route.ts.
#
# The secret key decides which mode everything runs in. An sk_test_ key sells
# test prices and delivers test webhooks; an sk_live_ key takes real money from
# real people. Nothing in the code branches on it, so the environment a
# deployment is given is the only thing standing between the two.
STRIPE_SECRET_KEY=

# Not read by anything today. Checkout is Stripe's hosted page, so the browser
# is redirected to Stripe rather than mounting Stripe.js, and there is nothing
# for a publishable key to do yet. Kept because an embedded card form or the
# customer portal would want it.
STRIPE_PUBLISHABLE_KEY=

# The two Stripe price ids the pricing cards sell. Both must belong to the same
# account and the same mode as STRIPE_SECRET_KEY, or Checkout refuses the
# session with a "no such price" error.
#
#   STRIPE_PRICE_STARTER      $29 a month, recurring, 150 applications a month.
#   STRIPE_PRICE_SEASON_PASS  $99 once, one payment, 500 applications.
#
# The caps live in lib/billing/plans.ts, not here. A price id says what Stripe
# charges; the catalog says what it buys.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_SEASON_PASS=

# The signing secret for this deployment's webhook endpoint, which is what
# app/api/webhooks/stripe/route.ts checks every delivery against. It is the only
# thing standing between a stranger and a free 500 application plan, because the
# route is public by necessity: Stripe has no session with us.
#
# One secret per endpoint. Stripe returns it once, when the endpoint is created,
# and it is different for every endpoint and every mode, so a value copied from
# another project or another environment fails every signature check with a
# message that reads like a Stripe outage.
STRIPE_WEBHOOK_SECRET=

# == Listing sources ===========================================================
# For reading the public internship listing repos (Simplify, Pitt CSC and
# friends) through the GitHub API instead of scraping rendered pages. A token
# with no scopes is enough for public repos and only raises the rate limit,
# from 60 requests an hour to 5000. Read by lib/ats-boards.ts.
#
# Optional. Without it the registry still seeds, sharing the anonymous budget
# with everything else coming from the same address.
GITHUB_TOKEN=

# == Form action cache (JOB-006) ===============================================
# The kill switch for the shared observe() replay cache in
# lib/form-action-cache.ts, which stores where each ATS platform puts the fields
# on its own form, so that finding them costs a model call once per form shape
# rather than once per application.
#
# Leave it unset. Set it to true only to turn the cache off without shipping
# code, if a stored plan ever starts pointing runs at the wrong control. With it
# off nothing is read and nothing is written, and every field is observed live
# exactly as it was before the cache existed.
FORM_ACTION_CACHE_DISABLED=

# == Background jobs ===========================================================
# Read by inngest/job-application-pipeline.ts and the ported Gmail listener.
INNGEST_EVENT_KEY=

# Local development against the Inngest dev server. Set to 1 to talk to a local
# dev server instead of Inngest Cloud. The v4 SDK does not infer this from
# NODE_ENV. Unset means Cloud, which then fails on a missing signing key.
# Read by inngest/load-env.ts.
INNGEST_DEV=

# == Gmail (V2 reference code, lib/future-gmail/) ==============================
# Nothing in the running app reads these today. They belong to the emailed
# security code flow, which is unwired until automated account creation ships.
# See lib/future-gmail/README.md.
#
# The OAuth client must be a Desktop app client, or a Web application client
# with http://localhost:53682/oauth/callback in its authorized redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Minted by `npm run gmail-auth`. Treat it like a password: it grants read
# access to the mailbox. Expires every 7 days while the Google Cloud OAuth app
# is in "Testing" publishing status.
GOOGLE_OAUTH_REFRESH_TOKEN=

# == Product analytics (JOB-014) ===============================================
# PostHog. Read by components/analytics.tsx in the browser and by
# lib/analytics/posthog-server.ts on the server, through
# lib/analytics/events.ts, which is the one place that decides whether capture
# is on at all.
#
# Everything here is optional and the app is expected to run with all three
# unset. That is the state on a fresh checkout and in CI, and it means every
# capture is a no op rather than an error. Nothing in this feature is allowed to
# fail a sign in, an intake or an application.
#
# The project key, which is the one that begins phc_ and is safe in a browser
# bundle. A key that does not begin phc_ is one of PostHog's other key types,
# and capture stays off rather than failing on every event.
NEXT_PUBLIC_POSTHOG_KEY=

# The ingestion host for the project's region. Defaults to
# https://us.i.posthog.com when unset, which is where this project lives. An EU
# project needs https://eu.i.posthog.com here.
NEXT_PUBLIC_POSTHOG_HOST=

# Capture from a development machine, which is off by default so that clicking
# around localhost does not land in the same funnel the product is measured on.
# Set it to true only while testing the instrumentation itself, and expect the
# events to be real events in the real project.
NEXT_PUBLIC_POSTHOG_CAPTURE_IN_DEV=


# ══════════════════════════════════════════════════════════════════════════════
# NOT YET WIRED: provisioned ahead of the tickets that need them
# ══════════════════════════════════════════════════════════════════════════════

# == Background jobs, cloud ====================================================
# Verifies that a request to the Inngest serve route really came from Inngest.
INNGEST_SIGNING_KEY=

# == Transactional email =======================================================
# Still read by no application code. Kept here because the account exists and
# the key will be wanted the day Jobinno sends anything that is not a sign in
# link, such as a receipt or a run summary.
#
# It is deliberately NOT how magic links get sent. Those are sent by Supabase
# Auth from Supabase's own servers, so no value in this file can affect them.
# See the JOB-024 note in supabase/config.toml.
RESEND_API_KEY=

# v1-C (#143). The From address the pending_user_input notifier sends from.
# Falls back to "Jobinno <hello@jobinno.app>" if unset. Must be a domain the
# Resend account is authorised to send on.
RESEND_FROM_ADDRESS=

# == SMS notifications (Twilio) ================================================
# v1-C (#143). Twilio credentials for the pending_user_input notifier's SMS
# path. Unset means the SMS channel is silently unavailable — a user who has
# picked `sms` (or `both`) as their notification_preference still gets the
# email path if `RESEND_API_KEY` is set, and gets nothing if it is not.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The password half of Supabase Auth's custom SMTP settings, which for Resend is
# a Resend API key (JOB-024). Read by nothing in the app and by nothing in CI.
# The single reader is `npm run supabase:auth-config`, which resolves it into
# `auth.email.smtp.pass` when that section of supabase/config.toml is enabled,
# so the key reaches the project without ever being written down in the
# repository.
#
# Leave it unset unless you are the person running that push. Unset simply means
# the SMTP section stays commented out and the push does not carry a password.
SUPABASE_AUTH_SMTP_PASS=

