# Jobinno environment.
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and
# must stay that way. Nothing in this file should ever carry a live secret.
#
# Two groups below. "IN USE" vars are read by code that exists today (grep
# `process.env` across `lib/` and `inngest/` and you will find every one of
# them). "NOT YET WIRED" vars are provisioned ahead of the tickets that will
# need them; nothing reads them yet, and an empty value breaks nothing today.


# ══════════════════════════════════════════════════════════════════════════════
# IN USE: read by the modules ported from actinno
# ══════════════════════════════════════════════════════════════════════════════

# == Job discovery =============================================================
# Apify token. Read by lib/search-job-listings.ts.
# apify.com/settings/integrations
APIFY_API_TOKEN=

# == Browser automation and the LLMs that drive it =============================
# The key that pays for every page Stagehand reads on a real employer's job
# board. Read by lib/stagehand-session.ts and the modules that open sessions
# through it. Deliberately its own key rather than a shared one: it should be
# independently rotatable and independently billable.
STAGEHAND_LLM_API_KEY=

# Resume parsing and free text answer generation. Read by lib/resume-parser.ts.
# Optional. Falls back to STAGEHAND_LLM_API_KEY.
#
# It has a separate name because the two LLM surfaces are different trust
# domains. STAGEHAND_LLM_API_KEY pays for calls that drive a browser; this one
# pays for calls that are text in, text out, with no tools attached and no
# ability to act. That is the only reason it is safe to hand a candidate's
# resume to it.
RESUME_LLM_API_KEY=

# == Remote browsers ===========================================================
# Browserbase runs the Stagehand sessions. Read by lib/stagehand-session.ts.
#
# Set both and every session is a remote Browserbase one. Leave both unset and
# it opens a local Chromium exactly as it did before JOB-005, which is what
# keeps `npm run fill-form` working on a machine with no Browserbase account.
# Setting one without the other is refused at launch rather than quietly
# treated as local, because that combination is a typo every time.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional. How many sessions this project may run at once, which is also the
# width `applyToJob` fans out to in inngest/job-application-pipeline.ts.
# Defaults to 3, the cap `GET /v1/projects/{id}` reports for the plan this
# project is on. Raise it here when the plan changes, not in code. Ignored
# entirely on the local path, which has its own lower limit for its own reasons.
BROWSERBASE_CONCURRENCY=

# == Supabase ==================================================================
# Read by lib/candidate-intake.ts, lib/resume-parser.ts,
# lib/fill-application-form.ts and lib/submit-application.ts.
#
# Note: the ported modules read SUPABASE_URL, while the Next.js app side reads
# NEXT_PUBLIC_SUPABASE_URL (below). They are the same project, spelled twice,
# until the ticket that unifies them lands. Set both to the same value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The one hosted Supabase project this checkout is allowed to read or write.
# Read by lib/supabase-project-guard.ts, which every module above calls before
# it creates a client.
#
# The value is the project ref, which is the first label of the SUPABASE_URL
# hostname: for https://efyubrtiptcsrhfakbwc.supabase.co the ref is
# efyubrtiptcsrhfakbwc, and that is Jobinno's own project. When SUPABASE_URL
# names anything else the guard refuses to run, so that a stale shell, a copied
# .env.local or a misaimed deploy cannot file a real candidate's rows in
# somebody else's database. The service role key bypasses row level security,
# so nothing further downstream would object.
#
# localhost and 127.0.0.1 are always allowed and never compared, because a
# local or self hosted Supabase has no project ref. CI relies on that.
#
# Unset is an error rather than a free pass: "nothing configured" and "any
# project is fine" are different statements and only one of them is safe.
EXPECTED_SUPABASE_PROJECT_REF=

# == Database ==================================================================
# Postgres connection string for Drizzle. In production this is the Supabase
# project's pooled connection string. Read by lib/db/client.ts, which is how
# JOB-003's board sync writes `boards` and `jobs`.
#
# Anything destructive that runs against this (a truncating test, a migration
# script) must be gated behind its own explicit opt in env var. See HARD STOP 5
# in CLAUDE.md.
DATABASE_URL=

# == Listing sources ===========================================================
# For reading the public internship listing repos (Simplify, Pitt CSC and
# friends) through the GitHub API instead of scraping rendered pages. A token
# with no scopes is enough for public repos and only raises the rate limit,
# from 60 requests an hour to 5000. Read by lib/ats-boards.ts.
#
# Optional. Without it the registry still seeds, sharing the anonymous budget
# with everything else coming from the same address.
GITHUB_TOKEN=

# == Background jobs ===========================================================
# Read by inngest/job-application-pipeline.ts and the ported Gmail listener.
INNGEST_EVENT_KEY=

# Local development against the Inngest dev server. Set to 1 to talk to a local
# dev server instead of Inngest Cloud. The v4 SDK does not infer this from
# NODE_ENV. Unset means Cloud, which then fails on a missing signing key.
# Read by inngest/load-env.ts.
INNGEST_DEV=

# == Gmail (V2 reference code, lib/future-gmail/) ==============================
# Nothing in the running app reads these today. They belong to the emailed
# security code flow, which is unwired until automated account creation ships.
# See lib/future-gmail/README.md.
#
# The OAuth client must be a Desktop app client, or a Web application client
# with http://localhost:53682/oauth/callback in its authorized redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Minted by `npm run gmail-auth`. Treat it like a password: it grants read
# access to the mailbox. Expires every 7 days while the Google Cloud OAuth app
# is in "Testing" publishing status.
GOOGLE_OAUTH_REFRESH_TOKEN=


# ══════════════════════════════════════════════════════════════════════════════
# NOT YET WIRED: provisioned ahead of the tickets that need them
# ══════════════════════════════════════════════════════════════════════════════

# == Supabase, app side ========================================================
# Auth and the browser client. NEXT_PUBLIC_ vars are compiled into the client
# bundle and are public by definition. Never put a service role key in one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# The server side key that bypasses row level security is SUPABASE_SERVICE_ROLE_KEY,
# declared once in the IN USE section above. It is not repeated here: a .env file
# with the same key twice silently keeps whichever line loads last, and this one
# is the key you least want a stale duplicate of.

# == Background jobs, cloud ====================================================
# Verifies that a request to the Inngest serve route really came from Inngest.
INNGEST_SIGNING_KEY=

# == Transactional email =======================================================
RESEND_API_KEY=

# == Billing ===================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# == Product analytics =========================================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
