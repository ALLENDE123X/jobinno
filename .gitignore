# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .env.example is the documented shape of the env, with no real values in it.
# It is the one .env file that belongs in the repo.
!.env.example

# Run artefacts written by the ported automation modules. Each carries a real
# candidate's real data, or a picture of a real employer's form with that data
# already typed into it. Never commit them.
lib/.form-fill-screenshots/
lib/.submission-screenshots/
lib/.stagehand-observe-cache.json

# Test output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Debugging artefacts. See HARD STOP 2 in CLAUDE.md: these are the file names
# that have actually been committed by accident before.
ci_log*.txt
pr_body.md
review.md
CONTEXT.md
output.txt
*.log
